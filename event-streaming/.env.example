# Local CPU event-streaming stack
DOCPIPE_API_BASE_URL=http://127.0.0.1:8080
OPENSEARCH_PASSWORD=
DOCPIPE_EVENT_STREAMING_ENABLED=true
KAFKA_INPUT_TOPIC=docpipe-input-topic
KAFKA_NOTIFICATION_TOPIC=docpipe-notification-topic
KAFKA_GROUP_ID=docpipe-input-cosumer

# Host-side Kafka notification consumer and event producer
KAFKA_BOOTSTRAP_SERVERS=127.0.0.1:9092
KAFKA_NOTIFICATION_GROUP_ID=docpipe-notifications-consumer
SCHEMA_REGISTRY_URL=http://127.0.0.1:8081
