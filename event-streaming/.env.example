# Docling Pipelines application
OPENSEARCH_PASSWORD=
DOCPIPE_EVENT_STREAMING_ENABLED=true
DOCPIPE_API_BASE_URL=http://127.0.0.1:8080
DOCPIPE_MAX_CONCURRENT_JOB_RUNS=1

# Kafka
KAFKA_BOOTSTRAP_SERVERS=127.0.0.1:9092
KAFKA_INPUT_TOPIC=docpipe-input
KAFKA_NOTIFICATION_TOPIC=docpipe-notifications
KAFKA_GROUP_ID=docpipe-event-consumer
KAFKA_NOTIFICATION_GROUP_ID=docpipe-notification-consumer

# Schema Registry
SCHEMA_REGISTRY_URL=http://127.0.0.1:8081
