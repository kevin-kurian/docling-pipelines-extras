{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Notification",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "operation",
    "status",
    "timestamp"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "format": "uuid"
    },
    "operation": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "Received",
        "Started",
        "Completed"
      ]
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "pages_processed": {
      "type": "integer",
      "minimum": 0,
      "description": "Page count available after extraction"
    }
  }
}
